# =============================================================================
# BU Papers 2.0 / ARMS — Environment Variables (placeholders only)
# Copy values into backend/.env (and frontend/.env for Vite). Never commit secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=Question Papers Platform
APP_VERSION=2.0.0

# Backend
PORT=3008
API_BASE_URL=http://localhost:3008
API_PREFIX=/api/v1

# Frontend (Vite)
# Frontend (Vercel) — set at build time
# VITE_API_BASE_URL=https://YOUR-API.onrender.com/api/v1

# After Vercel is live, set these on Render (no trailing slash).
# Use your real domain — e.g. https://bu-papers-ready-jlgx.vercel.app
# FRONTEND_URL=https://bu-papers-ready-jlgx.vercel.app
# CORS_ORIGINS=https://bu-papers-ready-jlgx.vercel.app,https://*.vercel.app
# API_BASE_URL=https://bu-papers-ready.onrender.com
FRONTEND_URL=http://localhost:3011
CORS_ORIGINS=http://localhost:3011

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local example: mongodb://127.0.0.1:27017/arms
MONGODB_URI=mongodb://127.0.0.1:27017/arms
MONGODB_DB_NAME=arms

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
SESSION_TIMEOUT_MINUTES=60
ACCOUNT_LOCK_MAX_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30
SUPER_ADMIN_2FA_ENABLED=true
CSRF_SECRET=change-me-csrf-secret-min-32-characters!!
COOKIE_SECURE=false

# Development bootstrap (seed scripts only — never used by frontend)
BOOTSTRAP_SUPERADMIN_EMAIL=superadmin@arms.local
BOOTSTRAP_SUPERADMIN_PASSWORD=ChangeMe!SuperAdmin1
BOOTSTRAP_SUPERADMIN_NAME=Super Admin
BOOTSTRAP_ADMIN_EMAIL=admin@arms.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!Admin1
BOOTSTRAP_ADMIN_NAME=Official Admin

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX=20
UPLOAD_RATE_LIMIT_MAX=30

# -----------------------------------------------------------------------------
# Cloud Storage
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=arms

# -----------------------------------------------------------------------------
# Storage Policy Defaults
# -----------------------------------------------------------------------------
MAX_FILE_SIZE_MB=25
ADMIN_STORAGE_QUOTA_MB=2048
RECYCLE_BIN_RETENTION_DAYS=30
DUPLICATE_DETECTION_ENABLED=true
AUTO_CLEANUP_ENABLED=true
MONTHLY_STORAGE_BUDGET_USD=50
STORAGE_WARNING_PERCENT=80
STORAGE_CRITICAL_PERCENT=95

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Papers <noreply@example.com>"

# -----------------------------------------------------------------------------
# Logging / Backup
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_DIR=logs
MORGAN_FORMAT=combined
BACKUP_ENABLED=true
BACKUP_CRON_DAILY=0 2 * * *
BACKUP_CRON_WEEKLY=0 3 * * 0
BACKUP_CRON_MONTHLY=0 4 1 * *
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# Maintenance / Swagger
# -----------------------------------------------------------------------------
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Website temporarily unavailable while maintenance is being performed.
SWAGGER_ENABLED=true
SWAGGER_PATH=/api/docs
# Required in production if Swagger remains enabled:
# SWAGGER_DOCS_KEY=long-random-docs-key
